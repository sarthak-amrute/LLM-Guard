# ==============================================================================
# LLMGuard Environment & Provider Configuration Example
# Copy this file to .env and configure credentials as needed.
# Note: Credentials can also be configured securely through the LLMGuard Web UI.
# ==============================================================================

# Master Secret Key for Target Credential Encryption (AES/Fernet)
# If left unset, LLMGuard automatically generates a persistent key in .secret.key
# LLMGUARD_SECRET_KEY=

# ── Google Gemini API Configuration ──────────────────────────────────────────
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-pro,gemini-1.5-flash

# ── OpenAI API Configuration ──────────────────────────────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Anthropic Claude API Configuration ────────────────────────────────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ── OpenRouter API Configuration ──────────────────────────────────────────────
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# ── TechMart Support Local Demonstration Target ──────────────────────────────
TECHMART_URL=http://127.0.0.1:8000
TARGET_MODE=SECURE
